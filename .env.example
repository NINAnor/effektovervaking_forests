# Copy to .env (never commit it). Real environment variables win over this file.
# CDSE S3 keys do NOT go here: put CDSE_S3_ACCESS_KEY / CDSE_S3_SECRET_KEY in
# ~/.config/cdse/credentials (mode 600). The project drive (CIFS) forces 755.
DEBUG=false

# --- layout (defaults shown) ---
# outputs go under <data>/operational
# FORESTMON_DATA_DIR=./data
# default <data>/aoi ; one GeoParquet per AOI
# FORESTMON_AOI_DIR=
# default <data>/logs
# FORESTMON_LOG_DIR=
# default <data>/web
# FORESTMON_WEB_OUT=
# default <data>/published
# FORESTMON_GIS_OUT=
# default <data>/opera_dist_alerts.parquet ; OPERA agreement term in alert confidence
# FORESTMON_OPERA_PARQUET=

# --- S3 (optional): S3 holds the data, the local data dir is a working copy ---
# rclone path, e.g. nina:forestmon ; configure the remote with `rclone config`.
# Each cycle (scripts/forestmon_cycle.sh) pulls, runs, and pushes back.
# FORESTMON_S3_REMOTE=

# --- external tools ---
# dir containing ogr2ogr (publish site)
# FORESTMON_GDAL_BIN=
# Earth Engine cloud project (condition step 02e; backup for embedding downloads)
# FORESTMON_EE_PROJECT=
# embedding source: source_coop (default) or ee
# AEF_SOURCE=source_coop
# CDSE_S3_ENDPOINT=https://eodata.dataspace.copernicus.eu
# Sentinel-2 source: eopf (default; EOPF from FORESTMON_EOPF_START, CDSE before) or cdse
# FORESTMON_S2_SOURCE=eopf
# FORESTMON_EOPF_START=2026-01-01

# --- tuning ---
# FORESTMON_MONITORING_START=2026-01-01
# FORESTMON_STORE_ALL=0
# FORESTMON_INGEST_BATCH=100

# --- health thresholds ---
# FORESTMON_STALE_STATE_DAYS=14
# FORESTMON_STALE_RUN_HOURS=48
# FORESTMON_MAX_BACKLOG=50
# FORESTMON_MAX_ERROR_RATE=0.10

# --- condition pipeline ---
# data root: data/cache and outputs/ ; default <FORESTMON_DATA_DIR>/condition
# CONDITION_ROOT=
# stand polygons; default <CONDITION_ROOT>/data/skog_kartlegginger.gpkg
# FORESTS_KARTLEGGING_GPKG=

# --- tests only (drift guards against the research repo) ---
# FORESTMON_INSPECTOR_SRC=/path/to/c2c_ts_server.py
# FORESTMON_LABEL_TUNING_CSV=/path/to/label_tuning_results.csv
